# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database (MongoDB Atlas SRV string in production) ----
# Local example: mongodb://127.0.0.1:27017/cymor-tap
MONGODB_URI=mongodb://127.0.0.1:27017/cymor-tap

# ---- URLs ----
# Where the Next.js app lives (used for CORS and password-reset links)
FRONTEND_URL=http://localhost:3000
# Additional allowed browser origins, comma separated (optional)
ALLOWED_ORIGINS=http://localhost:3000
# Base of the branded links. Links look like <SHORT_LINK_BASE_URL>/<slug>.
# Locally the API itself resolves them. In production point a subdomain
# such as https://tap.yourdomain.com at the Render service.
SHORT_LINK_BASE_URL=http://localhost:4000

# ---- Sessions and cookies ----
# REQUIRED in production, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=14
# lax works when the frontend and API share a registrable domain
# (app.example.com + api.example.com). Use "none" only if they do not, and
# note that some browsers block third-party cookies.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Product policy ----
GUEST_LINK_TTL_DAYS=90
REPORT_AUTO_DISABLE_THRESHOLD=5
# http = 302 redirect (default). page = HTML page with automatic redirect and a manual button.
REDIRECT_MODE=http
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1

# ---- Email for password reset (optional) ----
# Without SMTP the API tells the user that reset email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CYMOR TAP <no-reply@example.com>"
