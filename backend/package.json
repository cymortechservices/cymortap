{
  "name": "cymor-tap-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CYMOR TAP REST API and branded-link redirect service",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/db-init.ts",
    "abuse:list": "tsx scripts/abuse.ts list",
    "abuse:disable": "tsx scripts/abuse.ts disable",
    "abuse:enable": "tsx scripts/abuse.ts enable"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.18",
    "mongoose": "^8.9.2",
    "nodemailer": "^6.9.16",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
